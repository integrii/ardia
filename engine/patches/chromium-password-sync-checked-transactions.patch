+bool Database::BeginImmediateTransaction(InternalApiToken) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  if (!is_open() || options_.read_only_ || transaction_nesting_ != 0 ||
+      needs_rollback_ || immediate_transaction_active_ ||
+      sqlite3_get_autocommit(db_) == 0) {
+    return false;
+  }
+  auto incarnation = weak_factory_.GetWeakPtr();
+  Statement commit(GetCachedStatement(commit_statement_id_, "COMMIT"));
+  if (!incarnation || !commit.is_valid()) {
+    return false;
+  }
+  Statement rollback(GetCachedStatement(rollback_statement_id_, "ROLLBACK"));
+  if (!incarnation || !rollback.is_valid()) {
+    return false;
+  }
+  Statement health(GetCachedStatement(immediate_health_statement_id_,
+                                     "SELECT COUNT(*) FROM sqlite_schema"));
+  if (!incarnation || !health.is_valid()) {
+    return false;
+  }
+  Statement begin(GetCachedStatement(SQL_FROM_HERE, "BEGIN IMMEDIATE"));
+  if (!incarnation || !begin.is_valid()) {
+    return false;
+  }
+  const bool began = begin.Run();
+  if (!incarnation) {
+    return false;
+  }
+  if (!began || sqlite3_get_autocommit(db_) != 0) {
+    if (sqlite3_get_autocommit(db_) == 0) {
+      Poison();
+    }
+    return false;
+  }
+  needs_rollback_ = false;
+  transaction_nesting_ = 1;
+  immediate_transaction_active_ = true;
+  return true;
+}
+
+bool Database::IsImmediateTransactionActive(InternalApiToken) const {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  return is_open() && immediate_transaction_active_ &&
+         transaction_nesting_ == 1 && !needs_rollback_ &&
+         sqlite3_get_autocommit(db_) == 0;
+}
+
+TransactionResult Database::EndImmediateTransaction(bool commit_requested,
+                                                   InternalApiToken) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  if (!is_open()) {
+    return {false, TransactionConnectionState::kIncarnationEnded};
+  }
+  if (!immediate_transaction_active_ || transaction_nesting_ != 1) {
+    Poison();
+    return {false, TransactionConnectionState::kQuarantined};
+  }
+  bool committed = false;
+  auto incarnation = weak_factory_.GetWeakPtr();
+  if (commit_requested && !needs_rollback_ &&
+      sqlite3_get_autocommit(db_) == 0) {
+    Statement commit(GetCachedStatement(commit_statement_id_, "COMMIT"));
+    if (!incarnation) {
+      return {false, TransactionConnectionState::kIncarnationEnded};
+    }
+    if (commit.is_valid()) {
+      committed = commit.Run();
+    }
+    if (!incarnation) {
+      return {committed, TransactionConnectionState::kIncarnationEnded};
+    }
+    if (committed && sqlite3_get_autocommit(db_) == 0) {
+      Poison();
+      return {false, TransactionConnectionState::kQuarantined};
+    }
+  }
+  if (sqlite3_get_autocommit(db_) == 0) {
+    Statement rollback(GetCachedStatement(rollback_statement_id_, "ROLLBACK"));
+    if (!incarnation) {
+      return {committed, TransactionConnectionState::kIncarnationEnded};
+    }
+    const bool rolled_back = rollback.is_valid() && rollback.Run();
+    if (!incarnation) {
+      return {committed, TransactionConnectionState::kIncarnationEnded};
+    }
+    if (!rolled_back || sqlite3_get_autocommit(db_) == 0) {
+      Poison();
+      return {committed, TransactionConnectionState::kQuarantined};
+    }
+  }
+  Statement health(GetCachedStatement(immediate_health_statement_id_,
+                                     "SELECT COUNT(*) FROM sqlite_schema"));
+  if (!incarnation) {
+    return {committed, TransactionConnectionState::kIncarnationEnded};
+  }
+  const bool readable = health.is_valid() && health.Step() && !health.Step() &&
+                        health.Succeeded();
+  if (!incarnation) {
+    return {committed, TransactionConnectionState::kIncarnationEnded};
+  }
+  if (!readable || sqlite3_get_autocommit(db_) == 0) {
+    Poison();
+    return {committed, TransactionConnectionState::kQuarantined};
+  }
+  transaction_nesting_ = 0;
+  needs_rollback_ = false;
+  immediate_transaction_active_ = false;
+  return {committed, TransactionConnectionState::kAutocommit};
 }

