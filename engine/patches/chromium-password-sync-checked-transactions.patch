+  ASSERT_TRUE(account.Open(db_path_.AddExtensionASCII("account")));
+  for (Database* db : {&profile, &account}) {
+    ASSERT_TRUE(db->Execute("CREATE TABLE credentials(id INTEGER PRIMARY KEY, password)"));
+    ASSERT_TRUE(db->Execute("INSERT INTO credentials VALUES(1, 'original')"));
+  }
+  for (bool staging_succeeded : {false, true}) {
+    auto attempt = [&]() {
+      Transaction profile_guard(&profile);
+      if (!profile_guard.BeginImmediate()) {
+        return false;
+      }
+      Transaction account_guard(&account);
+      if (!account_guard.BeginImmediate()) {
+        return false;
+      }
+      if (!profile_guard.IsActive() ||
+          !profile.Execute("UPDATE credentials SET password = 'temporary'") ||
+          !staging_succeeded) {
+        return false;
+      }
+      const bool authorized = false;
+      return authorized;
+    };
+    EXPECT_FALSE(attempt());
+    ExpectImmediateConnectionTerminated(profile);
+    ExpectImmediateConnectionTerminated(account);
+    ExpectImmediateCredential(profile, "original");
+    ExpectImmediateCredential(account, "original");
+  }
+}
