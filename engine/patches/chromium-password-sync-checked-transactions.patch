+  Transaction transaction(&db);
+  ASSERT_TRUE(transaction.BeginImmediate());
+  ASSERT_TRUE(db.Execute("INSERT INTO credentials VALUES(2, 'temporary')"));
+  {
+    test::ScopedErrorExpecter errors;
+    errors.ExpectError(SQLITE_CONSTRAINT_UNIQUE);
+    EXPECT_FALSE(db.Execute(
+        "INSERT OR ROLLBACK INTO credentials VALUES(3, 'original')"));
+    EXPECT_TRUE(errors.SawExpectedErrors());
+  }
+  EXPECT_FALSE(transaction.IsActive());
+  EXPECT_TRUE(db.HasActiveTransactions());
+  bool next_stage_executed = false;
+  auto next_stage = [&]() {
+    if (!transaction.IsActive()) {
+      return false;
+    }
+    next_stage_executed = true;
+    return db.Execute("INSERT INTO credentials VALUES(4, 'forbidden')");
+  };
+  EXPECT_FALSE(next_stage());
+  EXPECT_FALSE(next_stage_executed);
+  const auto result = transaction.CommitChecked();
+  EXPECT_FALSE(result.committed);
+  EXPECT_EQ(result.connection_state, TransactionConnectionState::kAutocommit);
+  ExpectImmediateConnectionTerminated(db);
+  size_t count = 0;
+  ASSERT_TRUE(test::CountTableRows(&db, "credentials", &count));
+  EXPECT_EQ(count, 1u);
+  db.Close();
+  ASSERT_TRUE(db.Open(db_path_));
+  ExpectImmediateCredential(db, "original");
+}
