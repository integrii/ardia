+TEST_F(SQLTransactionTest, ImmediateCommitCallbackReopenLeavesNewTransactionAlone) {
+  Database db(test::kTestTag);
+  ASSERT_TRUE(db.Open(db_path_));
+  ASSERT_TRUE(db.Execute("PRAGMA foreign_keys = ON"));
+  ASSERT_TRUE(db.Execute("CREATE TABLE credentials(id INTEGER PRIMARY KEY, password)"));
+  ASSERT_TRUE(db.Execute("INSERT INTO credentials VALUES(1, 'original')"));
+  ASSERT_TRUE(db.Execute("CREATE TABLE child(parent INTEGER REFERENCES credentials(id) "
+                         "DEFERRABLE INITIALLY DEFERRED)"));
+  std::unique_ptr<Transaction> reopened;
+  int commit_errors = 0;
+  db.set_error_callback(base::BindLambdaForTesting(
+      [&](int error, Statement* statement) {
+        EXPECT_EQ(error, SQLITE_CONSTRAINT_FOREIGNKEY);
+        ASSERT_NE(statement, nullptr);
+        EXPECT_EQ(statement->GetSQLStatement(), "COMMIT");
+        ++commit_errors;
+        db.Poison();
+        db.Close();
+        ASSERT_TRUE(db.Open(db_path_));
+        reopened = std::make_unique<Transaction>(&db);
+        ASSERT_TRUE(reopened->BeginImmediate());
+        ASSERT_TRUE(db.Execute("UPDATE credentials SET password = 'new incarnation'"));
+      }));
+  {
+    Transaction old(&db);
+    ASSERT_TRUE(old.BeginImmediate());
+    ASSERT_TRUE(db.Execute("UPDATE credentials SET password = 'discarded'"));
+    ASSERT_TRUE(db.Execute("INSERT INTO child VALUES(99)"));
+    test::ScopedErrorExpecter errors;
+    errors.ExpectError(SQLITE_CONSTRAINT_FOREIGNKEY);
+    const auto result = old.CommitChecked();
+    EXPECT_TRUE(errors.SawExpectedErrors());
+    EXPECT_FALSE(result.committed);
+    EXPECT_EQ(result.connection_state, TransactionConnectionState::kIncarnationEnded);
+  }
+  EXPECT_EQ(commit_errors, 1);
+  ASSERT_TRUE(reopened);
+  EXPECT_TRUE(reopened->IsActive());
+  db.reset_error_callback();
+  EXPECT_TRUE(reopened->CommitChecked().committed);
+  ExpectImmediateConnectionTerminated(db);
+  ExpectImmediateCredential(db, "new incarnation");
+}
