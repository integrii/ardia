+TEST_F(SQLTransactionTest, ImmediateAutomaticRollbackRejectsGuardedNextStage) {
+  Database db(test::kTestTag);
+  ASSERT_TRUE(db.Open(db_path_));
+  ASSERT_TRUE(db.Execute("CREATE TABLE credentials(id INTEGER PRIMARY KEY, password UNIQUE)"));
