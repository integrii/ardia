+CheckedStatement::CheckedStatement(Database& database, base::cstring_view sql)
+    : database_(database.GetWeakPtr(InternalApiToken())), sql_(sql) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  if (!database_) {
+    Fail(CheckedStatementStage::kIncarnation);
+    result_.connection = CheckedStatementConnection::kIncarnationEnded;
+    return;
+  }
+  ref_ = database.GetUniqueStatement(sql);
+  if (!CheckLive()) {
+    return;
+  }
+  const int count = sqlite3_bind_parameter_count(ref_->stmt());
+  bound_.resize(count, false);
+  for (int index = 1; index <= count; ++index) {
+    if (sqlite3_bind_parameter_name(ref_->stmt(), index)) {
+      Fail(CheckedStatementStage::kPrepare);
+      break;
+    }
+  }
+}
+
+CheckedStatement::~CheckedStatement() {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  static_cast<void>(Finish());
+}
+
+bool CheckedStatement::Fail(CheckedStatementStage stage,
+                           std::optional<int> sqlite_code) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  if (!finished_ && !result_.error) {
+    result_.error = CheckedStatementError{stage, sqlite_code};
+  }
+  return false;
+}
+
+bool CheckedStatement::CheckLive() {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  if (finished_) {
+    return false;
+  }
+  if (!database_) {
+    result_.connection = CheckedStatementConnection::kIncarnationEnded;
+    return Fail(CheckedStatementStage::kIncarnation);
+  }
+  if (!ref_ || !ref_->is_valid()) {
+    return Fail(CheckedStatementStage::kPrepare);
+  }
+  return true;
+}
+
+bool CheckedStatement::CanBind(int index) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  if (finished_ || result_.error) {
+    return false;
+  }
+  if (in_progress_ || mode_ != Mode::kUnstarted || index < 0 ||
+      index == std::numeric_limits<int>::max()) {
+    return Fail(CheckedStatementStage::kUsage);
+  }
+  if (!CheckLive()) {
+    return false;
+  }
+  if (static_cast<size_t>(index) < bound_.size() && bound_[index]) {
+    return Fail(CheckedStatementStage::kBind);
+  }
+  return true;
+}
+
+bool CheckedStatement::RecordBind(int index, int sqlite_code) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  if (sqlite_code != SQLITE_OK) {
+    return Fail(CheckedStatementStage::kBind, sqlite_code);
+  }
+  if (!CheckLive()) {
+    return false;
+  }
+  CHECK_LT(static_cast<size_t>(index), bound_.size());
+  bound_[index] = true;
+  return true;
+}
+
+bool CheckedStatement::BindNull(int index) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  if (!CanBind(index)) {
+    return false;
+  }
+  return RecordBind(index, sqlite3_bind_null(ref_->stmt(), index + 1));
+}
+
+bool CheckedStatement::BindInt(int index, int value) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  if (!CanBind(index)) {
+    return false;
+  }
+  return RecordBind(index, sqlite3_bind_int(ref_->stmt(), index + 1, value));
+}
+
+bool CheckedStatement::BindInt64(int index, int64_t value) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  if (!CanBind(index)) {
+    return false;
+  }
+  return RecordBind(index, sqlite3_bind_int64(ref_->stmt(), index + 1, value));
+}
+
+bool CheckedStatement::BindString(int index, std::string_view value) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  if (!CanBind(index)) {
+    return false;
+  }
+  if (value.size() > static_cast<size_t>(std::numeric_limits<int>::max())) {
+    return Fail(CheckedStatementStage::kBind);
+  }
+  const char* data = value.empty() ? "" : value.data();
+  return RecordBind(index, sqlite3_bind_text(ref_->stmt(), index + 1, data,
+                                            static_cast<int>(value.size()),
+                                            SQLITE_TRANSIENT));
+}
+
+bool CheckedStatement::BindBlob(int index, base::span<const uint8_t> value) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  if (!CanBind(index)) {
+    return false;
+  }
+  if (value.size() > static_cast<size_t>(std::numeric_limits<int>::max())) {
+    return Fail(CheckedStatementStage::kBind);
+  }
+  static constexpr uint8_t empty = 0;
+  const uint8_t* data = value.empty() ? &empty : value.data();
+  return RecordBind(index, sqlite3_bind_blob(ref_->stmt(), index + 1, data,
+                                            static_cast<int>(value.size()),
+                                            SQLITE_TRANSIENT));
+}
+
+bool CheckedStatement::CanExecute() {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  if (finished_ || result_.error) {
+    return false;
+  }
+  if (in_progress_ || result_.done) {
+    return Fail(CheckedStatementStage::kUsage);
+  }
+  if (!CheckLive()) {
+    return false;
+  }
+  if (!std::all_of(bound_.begin(), bound_.end(), [](bool bound) { return bound; })) {
+    return Fail(CheckedStatementStage::kBind);
+  }
+  return true;
+}
+
+int CheckedStatement::Execute() {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  base::AutoReset progress(&in_progress_, true);
+  live_row_ = false;
+  std::optional<base::ScopedBlockingCall> scoped_blocking_call;
+  ref_->InitScopedBlockingCall(FROM_HERE, &scoped_blocking_call);
+  const int code = sqlite3_step(ref_->stmt());
+  if (code != SQLITE_ROW && code != SQLITE_DONE) {
+    Fail(CheckedStatementStage::kExecute, code);
+    if (database_) {
+      database_->OnSqliteError(ToSqliteErrorCode(ToSqliteResultCode(code)),
+                               nullptr, sql_.c_str());
+    }
+  }
+  if (!CheckLive() || result_.error) {
+    return SQLITE_ERROR;
+  }
+  live_row_ = code == SQLITE_ROW;
+  result_.done = code == SQLITE_DONE;
+  return code;
+}
+
+bool CheckedStatement::Run() {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  if (!CanExecute()) {
+    return false;
+  }
+  if (mode_ != Mode::kUnstarted || sqlite3_column_count(ref_->stmt()) != 0) {
+    return Fail(CheckedStatementStage::kUsage);
+  }
+  mode_ = Mode::kRun;
+  return Execute() == SQLITE_DONE;
+}
+
+CheckedStepResult CheckedStatement::Step() {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  if (!CanExecute()) {
+    return CheckedStepResult::kError;
+  }
+  if (mode_ == Mode::kRun || sqlite3_stmt_readonly(ref_->stmt()) == 0) {
+    Fail(CheckedStatementStage::kUsage);
+    return CheckedStepResult::kError;
+  }
+  mode_ = Mode::kStep;
+  const int code = Execute();
+  if (code == SQLITE_ROW) {
+    return CheckedStepResult::kRow;
+  }
+  return code == SQLITE_DONE ? CheckedStepResult::kDone
+                             : CheckedStepResult::kError;
+}
+
+bool CheckedStatement::CheckColumn(int index) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  if (finished_ || result_.error) {
+    return false;
+  }
+  if (in_progress_ || !live_row_ || !CheckLive()) {
+    return Fail(CheckedStatementStage::kColumn);
+  }
+  if (index < 0 || index >= sqlite3_column_count(ref_->stmt())) {
+    return Fail(CheckedStatementStage::kColumn);
+  }
+  return true;
+}
+
+bool CheckedStatement::CheckColumnError() {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  if (!CheckLive()) {
+    return false;
+  }
+  const int code = sqlite3_errcode(database_->db(InternalApiToken()));
+  if (code != SQLITE_OK && code != SQLITE_ROW && code != SQLITE_DONE) {
+    return Fail(CheckedStatementStage::kColumn, code);
+  }
+  return true;
+}
+
+std::optional<ColumnType> CheckedStatement::GetColumnType(int index) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  if (!CheckColumn(index)) {
+    return std::nullopt;
+  }
+  return static_cast<ColumnType>(sqlite3_column_type(ref_->stmt(), index));
+}
+
+bool CheckedStatement::ReadInt64(int index, std::optional<int64_t>& value) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  value.reset();
+  const auto type = GetColumnType(index);
+  if (!type) {
+    return false;
+  }
+  if (*type == ColumnType::kNull) {
+    return true;
+  }
+  if (*type != ColumnType::kInteger) {
+    return Fail(CheckedStatementStage::kColumn);
+  }
+  const int64_t integer = sqlite3_column_int64(ref_->stmt(), index);
+  if (!CheckColumnError()) {
+    return false;
+  }
+  value = integer;
+  return true;
+}
+
+bool CheckedStatement::ReadString(int index, std::optional<std::string>& value) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  value.reset();
+  const auto type = GetColumnType(index);
+  if (!type) {
+    return false;
+  }
+  if (*type == ColumnType::kNull) {
+    return true;
+  }
+  if (*type != ColumnType::kText) {
+    return Fail(CheckedStatementStage::kColumn);
+  }
+  const unsigned char* data = sqlite3_column_text(ref_->stmt(), index);
+  if (!CheckColumnError()) {
+    return false;
+  }
+  if (!data) {
+    return Fail(CheckedStatementStage::kColumn);
+  }
+  const int size = sqlite3_column_bytes(ref_->stmt(), index);
+  if (!CheckColumnError() || size < 0) {
+    return Fail(CheckedStatementStage::kColumn);
+  }
+  value.emplace(reinterpret_cast<const char*>(data), static_cast<size_t>(size));
+  return true;
+}
+
+bool CheckedStatement::ReadBlob(int index,
+                              std::optional<std::vector<uint8_t>>& value) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  value.reset();
+  const auto type = GetColumnType(index);
+  if (!type) {
+    return false;
+  }
+  if (*type == ColumnType::kNull) {
+    return true;
+  }
+  if (*type != ColumnType::kBlob) {
+    return Fail(CheckedStatementStage::kColumn);
+  }
+  const void* data = sqlite3_column_blob(ref_->stmt(), index);
+  if (!CheckColumnError()) {
+    return false;
+  }
+  const int size = sqlite3_column_bytes(ref_->stmt(), index);
+  if (!CheckColumnError() || size < 0 || (!data && size != 0)) {
+    return Fail(CheckedStatementStage::kColumn);
+  }
+  value.emplace();
+  if (size != 0) {
+    const auto* bytes = static_cast<const uint8_t*>(data);
+    value->assign(bytes, bytes + size);
+  }
+  return true;
+}
+
+CheckedStatementResult CheckedStatement::Finish() {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  if (finished_) {
+    return result_;
+  }
+  if (in_progress_) {
+    Fail(CheckedStatementStage::kUsage);
+    return result_;
+  }
+  base::AutoReset progress(&in_progress_, true);
+  live_row_ = false;
+  if (!database_) {
+    result_.connection = CheckedStatementConnection::kIncarnationEnded;
+    Fail(CheckedStatementStage::kIncarnation);
+  } else if (ref_ && ref_->is_valid()) {
+    const auto cleanup = ref_->FinalizeChecked();
+    result_.reset_code = cleanup.reset_code;
+    result_.clear_bindings_code = cleanup.clear_bindings_code;
+    result_.finalize_code = cleanup.finalize_code;
+    if (cleanup.reset_code != SQLITE_OK) {
+      Fail(CheckedStatementStage::kReset, cleanup.reset_code);
+    }
+    if (cleanup.clear_bindings_code != SQLITE_OK) {
+      Fail(CheckedStatementStage::kClearBindings, cleanup.clear_bindings_code);
+    }
+    if (cleanup.finalize_code != SQLITE_OK) {
+      Fail(CheckedStatementStage::kFinalize, cleanup.finalize_code);
+    }
+    const bool cleanup_ok = cleanup.reset_code == SQLITE_OK &&
+                            cleanup.clear_bindings_code == SQLITE_OK &&
+                            cleanup.finalize_code == SQLITE_OK;
+    result_.cleanup_checked = cleanup_ok;
+    if (!database_) {
+      result_.connection = CheckedStatementConnection::kIncarnationEnded;
+      Fail(CheckedStatementStage::kIncarnation);
+    } else if (!cleanup_ok) {
+      database_->Poison();
+      result_.connection = CheckedStatementConnection::kQuarantined;
+    }
+  }
+  ref_.reset();
+  finished_ = true;
+  return result_;
+}
+
+CheckedStatementResult CheckedStatement::result() const {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  return result_;
+}
