+
+void ExpectCheckedResultEqual(const CheckedStatementResult& left,
+                              const CheckedStatementResult& right) {
+  EXPECT_EQ(left.done, right.done);
+  EXPECT_EQ(left.cleanup_checked, right.cleanup_checked);
+  EXPECT_EQ(left.reset_code, right.reset_code);
+  EXPECT_EQ(left.clear_bindings_code, right.clear_bindings_code);
+  EXPECT_EQ(left.finalize_code, right.finalize_code);
+  EXPECT_EQ(left.connection, right.connection);
+  ASSERT_EQ(left.error.has_value(), right.error.has_value());
