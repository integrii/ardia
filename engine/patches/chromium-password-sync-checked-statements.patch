+Database::StatementRef::CheckedFinalizationResult
+Database::StatementRef::FinalizeChecked() {
+  CHECK(stmt_);
+  CHECK(database_);
+  DCHECK_CALLED_ON_VALID_SEQUENCE(database_->sequence_checker_);
+  std::optional<base::ScopedBlockingCall> scoped_blocking_call;
+  InitScopedBlockingCall(FROM_HERE, &scoped_blocking_call);
+  const int reset_code = sqlite3_reset(stmt_);
+  const int clear_bindings_code = sqlite3_clear_bindings(stmt_);
+  sqlite3_stmt* statement = stmt_;
+  stmt_ = nullptr;
+  database_->StatementRefDeleted(this);
+  database_ = nullptr;
+  was_valid_ = false;
+  const int finalize_code = sqlite3_finalize(statement);
+  bound_blobs_.clear();
+  return {reset_code, clear_bindings_code, finalize_code};
+}
