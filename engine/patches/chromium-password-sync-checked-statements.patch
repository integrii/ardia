+  EXPECT_EQ(integer, std::numeric_limits<int>::max());
+  ASSERT_TRUE(query.ReadInt64(7, integer));
+  EXPECT_FALSE(integer);
+  std::optional<std::string> copied_text;
+  std::optional<std::vector<uint8_t>> copied_blob;
+  ASSERT_TRUE(query.ReadString(4, copied_text));
+  ASSERT_TRUE(query.ReadBlob(5, copied_blob));
+  EXPECT_EQ(query.GetColumnType(4), ColumnType::kText);
+  EXPECT_EQ(query.GetColumnType(5), ColumnType::kBlob);
+  EXPECT_EQ(query.GetColumnType(7), ColumnType::kNull);
+  EXPECT_FALSE(query.result().succeeded());
+  ASSERT_EQ(query.Step(), CheckedStepResult::kDone);
+  const auto result = query.Finish();
+  EXPECT_TRUE(result.succeeded());
+  EXPECT_EQ(result.reset_code, SQLITE_OK);
+  EXPECT_EQ(result.clear_bindings_code, SQLITE_OK);
+  EXPECT_EQ(result.finalize_code, SQLITE_OK);
+  EXPECT_EQ(copied_text, std::string("a\0b", 3));
+  ASSERT_TRUE(copied_blob);
+  EXPECT_EQ(*copied_blob, (std::vector<uint8_t>{0, 1, 255, 0}));
+}
