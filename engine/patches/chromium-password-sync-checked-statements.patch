+  ASSERT_TRUE(query.BindNull(7));
+  text.assign(3, 'z');
+  blob.assign(4, 42);
+  ASSERT_EQ(query.Step(), CheckedStepResult::kRow);
+  std::optional<int64_t> integer;
+  ASSERT_TRUE(query.ReadInt64(0, integer));
+  EXPECT_EQ(integer, 0);
+  ASSERT_TRUE(query.ReadInt64(1, integer));
+  EXPECT_EQ(integer, std::numeric_limits<int>::min());
+  ASSERT_TRUE(query.ReadInt64(2, integer));
+  EXPECT_EQ(integer, std::numeric_limits<int64_t>::min());
+  ASSERT_TRUE(query.ReadInt64(3, integer));
