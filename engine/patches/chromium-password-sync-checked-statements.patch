+class CheckedCleanupDriveErrorVfs : public test::DriveErrorTestVfs {
+ public:
+  int Close(sqlite3_file* file) override {
+    const int result = test::TestVfs::Close(file);
+    if (result == SQLITE_OK) {
+      ++successful_closes_;
+    }
+    return result;
+  }
+
+  int Unlock(sqlite3_file* file, int mode) override {
+    return test::TestVfs::Unlock(file, mode);
