+TEST_F(CheckedStatementTest, CheckedClosedConnectionCannotPrepare) {
+  db_.Close();
+  CheckedStatement closed(db_, "SELECT 1");
+  EXPECT_FALSE(closed.BindInt(0, 1));
+  EXPECT_FALSE(closed.Run());
+  EXPECT_EQ(closed.Step(), CheckedStepResult::kError);
+  const auto result = closed.Finish();
+  EXPECT_EQ(result.connection, CheckedStatementConnection::kIncarnationEnded);
+  EXPECT_FALSE(result.cleanup_checked);
+  EXPECT_FALSE(result.succeeded());
+}
