+TEST_F(CheckedStatementTest, CheckedReadIoFailureCleanupUsesPhysicalClose) {
+  CheckedCleanupDriveErrorVfs vfs;
+  Database db(DatabaseOptions().set_cache_size(1), test::kTestTag);
+  const auto path = temp_dir_.GetPath().AppendASCII("io.sqlite");
+  ASSERT_TRUE(db.Open(path));
+  ASSERT_TRUE(db.Execute("CREATE TABLE credentials(id INTEGER PRIMARY KEY, password TEXT)"));
+  ASSERT_TRUE(db.Execute(
+      "WITH RECURSIVE ids(id) AS (VALUES(1) UNION ALL SELECT id+1 FROM ids WHERE id<128) "
+      "INSERT INTO credentials SELECT id, printf('%04096d', id) FROM ids"));
+  db.set_error_callback(base::BindLambdaForTesting(
+      [](int, Statement* statement) { EXPECT_EQ(statement, nullptr); }));
+  CheckedStatement read(db, "SELECT password FROM credentials ORDER BY id");
+  const int closes_before = vfs.successful_closes();
+  vfs.set_drive_unusable(true);
+  CheckedStepResult step = CheckedStepResult::kRow;
+  for (int index = 0; index < 129 && step == CheckedStepResult::kRow; ++index) {
+    step = read.Step();
+  }
+  const auto result = read.Finish();
+  EXPECT_GT(vfs.successful_closes(), closes_before);
+  vfs.set_drive_unusable(false);
+  EXPECT_EQ(step, CheckedStepResult::kError);
+  ASSERT_TRUE(result.error);
+  EXPECT_EQ(result.error->stage, CheckedStatementStage::kExecute);
+  ASSERT_TRUE(result.reset_code);
+  EXPECT_EQ(*result.reset_code & 0xff, SQLITE_IOERR);
+  EXPECT_TRUE(result.clear_bindings_code.has_value());
+  EXPECT_TRUE(result.finalize_code.has_value());
+  EXPECT_EQ(result.connection, CheckedStatementConnection::kQuarantined);
+  EXPECT_FALSE(db.is_open());
+  EXPECT_FALSE(db.Execute("DELETE FROM credentials"));
+  db.Close();
+  ASSERT_TRUE(db.Open(path));
+  size_t count = 0;
+  ASSERT_TRUE(test::CountTableRows(&db, "credentials", &count));
+  EXPECT_EQ(count, 128u);
+}
