+    db_.Poison();
+    db_.Close();
+    ASSERT_TRUE(db_.Open(path_));
+    ASSERT_TRUE(db_.Execute("BEGIN IMMEDIATE"));
+    std::optional<int64_t> value;
+    EXPECT_FALSE(old.ReadInt64(0, value));
+    EXPECT_EQ(old.Step(), CheckedStepResult::kError);
+    const auto result = old.Finish();
+    EXPECT_EQ(result.connection, CheckedStatementConnection::kIncarnationEnded);
+    EXPECT_FALSE(result.succeeded());
+    ASSERT_TRUE(db_.Execute("ROLLBACK"));
+  }
+}
