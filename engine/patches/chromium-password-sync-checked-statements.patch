+TEST_F(CheckedStatementTest, CheckedBindFailureStillRejectsActiveTransaction) {
+  ASSERT_TRUE(db_.Execute("CREATE TABLE credentials(value)"));
+  Transaction guard(&db_);
+  ASSERT_TRUE(guard.BeginImmediate());
+  {
+    CheckedStatement provisional(db_, "INSERT INTO credentials VALUES('temporary')");
+    ASSERT_TRUE(provisional.Run());
+    ASSERT_TRUE(provisional.Finish().succeeded());
+  }
+  CheckedStatement invalid(db_, "INSERT INTO credentials VALUES(?)");
+  EXPECT_FALSE(invalid.BindString(1, "wrong slot"));
+  EXPECT_TRUE(guard.IsActive());
+  EXPECT_FALSE(invalid.Run());
+  EXPECT_FALSE(invalid.Finish().succeeded());
+  EXPECT_FALSE(guard.RollbackChecked().committed);
+  size_t count = 1;
+  ASSERT_TRUE(test::CountTableRows(&db_, "credentials", &count));
+  EXPECT_EQ(count, 0u);
+}
