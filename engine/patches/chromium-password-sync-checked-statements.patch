+TEST_F(CheckedStatementTest, CheckedPrepareCallbackCannotAdoptReopenedConnection) {
+  std::unique_ptr<Transaction> replacement;
+  db_.set_error_callback(base::BindLambdaForTesting(
+      [&](int code, Statement* statement) {
+        EXPECT_EQ(code, SQLITE_ERROR);
+        EXPECT_EQ(statement, nullptr);
+        db_.Poison();
+        db_.Close();
+        ASSERT_TRUE(db_.Open(path_));
+        replacement = std::make_unique<Transaction>(&db_);
+        ASSERT_TRUE(replacement->Begin());
+      }));
+  test::ScopedErrorExpecter errors;
+  errors.ExpectError(SQLITE_ERROR);
+  CheckedStatement failed(db_, "SELECT missing FROM absent");
+  EXPECT_TRUE(errors.SawExpectedErrors());
+  EXPECT_FALSE(failed.Run());
+  const auto result = failed.Finish();
+  EXPECT_EQ(result.connection, CheckedStatementConnection::kIncarnationEnded);
+  EXPECT_FALSE(result.reset_code);
+  EXPECT_FALSE(result.finalize_code);
+  ASSERT_TRUE(replacement);
+  EXPECT_EQ(db_.transaction_nesting(), 1);
+  db_.reset_error_callback();
+  EXPECT_TRUE(replacement->Commit());
+}
