+  credential.username_value = u"user";
+  credential.password_value = PasswordString(u"old");
+  credential.date_created = base::Time::UnixEpoch();
+  auto inserted = helper->AddLogin(std::move(credential));
+  ASSERT_TRUE(inserted.has_value());
+  ASSERT_TRUE(inserted->has_value());
+  ASSERT_EQ((*inserted)->size(), 1u);
+  const auto key = (**inserted)[0].credential().primary_key;
+  auto& metadata_store = ConditionalHelperMetadataStore(*helper);
+  sync_pb::EntityMetadata metadata;
+  metadata.set_sequence_number(7);
+  ASSERT_TRUE(metadata_store.UpdateEntityMetadata(syncer::PASSWORDS, "999",
+                                                  metadata));
+  auto metadata_before = metadata_store.GetAllSyncMetadata(syncer::PASSWORDS);
+  ASSERT_TRUE(metadata_before);
+  ASSERT_EQ(metadata_before->GetAllMetadata().size(), 1u);
+  ASSERT_TRUE(metadata_before->GetAllMetadata().contains("999"));
+  const std::string changes_before = sql::test::ExecuteWithResult(
+      &ConditionalHelperSqlDatabase(*helper), "SELECT total_changes()");
+  EXPECT_CALL(processor, IsTrackingMetadata())
+      .Times(3)
+      .WillRepeatedly(Return(true));
+  int native_callbacks = 0;
+  for (int operation = 0; operation < 3; ++operation) {
+    ConditionalLoginMutation mutation;
+    mutation.origin = GURL("https://conditional.example/");
+    mutation.username = u"user";
+    mutation.expected_password = PasswordString(u"old");
+    mutation.replacement_password = PasswordString(u"remote");
+    if (operation == 0) {
+      mutation.username = u"new-user";
+      mutation.expected_password.reset();
+    } else if (operation == 2) {
+      mutation.replacement_password.reset();
+    }
+    auto lease = base::MakeRefCounted<PasswordStoreAuthorizationLease>(
+        base::TimeTicks::Now() + base::Seconds(10),
+        +[](void* context) { ++*static_cast<int*>(context); return 1; },
+        +[](void* context, int) { ++*static_cast<int*>(context); },
+        &native_callbacks);
+    auto result = helper->CompareAndSetLogin(std::move(mutation), lease);
+    EXPECT_EQ(result.status, ConditionalLoginMutationStatus::kError);
+    EXPECT_TRUE(result.changes.empty());
+    EXPECT_EQ(sql::test::ExecuteWithResult(
+                  &ConditionalHelperSqlDatabase(*helper), "SELECT total_changes()"),
+              changes_before);
+  }
+  EXPECT_EQ(native_callbacks, 0);
+  auto rows = helper->GetAllLogins();
+  ASSERT_TRUE(rows.has_value());
+  ASSERT_EQ(rows->size(), 1u);
+  EXPECT_EQ((*rows)[0].password_value, u"old");
+  EXPECT_EQ((*rows)[0].date_created, base::Time::UnixEpoch());
+  EXPECT_EQ((*rows)[0].primary_key, key);
+  auto metadata_after = metadata_store.GetAllSyncMetadata(syncer::PASSWORDS);
+  ASSERT_TRUE(metadata_after);
+  ASSERT_EQ(metadata_after->GetAllMetadata().size(), 1u);
+  ASSERT_TRUE(metadata_after->GetAllMetadata().contains("999"));
+  EXPECT_EQ(metadata_after->GetAllMetadata().at("999")->SerializeAsString(),
+            metadata_before->GetAllMetadata().at("999")->SerializeAsString());
+  EXPECT_EQ(metadata_after->GetDataTypeState().SerializeAsString(),
+            metadata_before->GetDataTypeState().SerializeAsString());
+}
