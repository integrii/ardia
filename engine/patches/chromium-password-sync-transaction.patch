+enum class ConditionalLoginMutationStatus {
+  kCommitted,
+  kConflict,
+  kError,
+  kUnauthorized,
+};
+
+struct ConditionalLoginMutation {
+  GURL origin;
+  std::u16string username;
+  std::optional<PasswordString> expected_password;
+  std::optional<PasswordString> replacement_password;
+  base::Time date_created;
+
+  bool IsValid() const {
+    return origin.is_valid() && origin.SchemeIsHTTPOrHTTPS() &&
+           origin == origin.DeprecatedGetOriginAsURL() &&
+           origin.spec().size() <= 4096 && username.size() <= 1024 &&
+           (!expected_password || expected_password->size() <= 16384) &&
+           (!replacement_password ||
+            (!replacement_password->empty() &&
+             replacement_password->size() <= 16384)) &&
+           (expected_password || replacement_password) &&
+           (date_created.is_null() ||
+            (!date_created.is_inf() &&
+             date_created >= base::Time::FromMillisecondsSinceUnixEpoch(
+                                 -8640000000000000LL) &&
+             date_created <= base::Time::FromMillisecondsSinceUnixEpoch(
+                                 8640000000000000LL)));
+  }
+};
+
+class PasswordStoreAuthorizationLease
+    : public base::RefCountedThreadSafe<PasswordStoreAuthorizationLease> {
+ public:
+  explicit PasswordStoreAuthorizationLease(
+      base::TimeTicks deadline,
+      int (*begin_commit)(void*) = nullptr,
+      void (*end_commit)(void*, int) = nullptr,
+      void* context = nullptr)
+      : deadline_(std::min(deadline,
+                           base::TimeTicks::Now() + base::Seconds(10))),
+        begin_commit_(begin_commit),
+        end_commit_(end_commit),
+        context_(context) {}
+
+  void Revoke() {
+    base::AutoLock lock(lock_);
+    revoked_ = true;
+  }
+
+  bool IsAuthorized() const {
+    base::AutoLock lock(lock_);
+    return !revoked_ && base::TimeTicks::Now() < deadline_;
+  }
+
+  ConditionalLoginMutationStatus Commit(base::OnceCallback<bool()> commit) {
+    base::AutoLock lock(lock_);
+    if (revoked_ || base::TimeTicks::Now() >= deadline_) {
+      return ConditionalLoginMutationStatus::kUnauthorized;
+    }
+    if ((begin_commit_ && !end_commit_) ||
+        (!begin_commit_ && end_commit_)) {
+      return ConditionalLoginMutationStatus::kError;
+    }
+    if (begin_commit_ && !begin_commit_(context_)) {
+      return ConditionalLoginMutationStatus::kUnauthorized;
+    }
+    const bool committed = std::move(commit).Run();
+    if (end_commit_) {
+      end_commit_(context_, committed ? 1 : 0);
+    }
+    return committed ? ConditionalLoginMutationStatus::kCommitted
+                     : ConditionalLoginMutationStatus::kError;
+  }
+
+ private:
+  friend class base::RefCountedThreadSafe<PasswordStoreAuthorizationLease>;
+  ~PasswordStoreAuthorizationLease() = default;
+
+  mutable base::Lock lock_;
+  bool revoked_ GUARDED_BY(lock_) = false;
+  const base::TimeTicks deadline_;
+  int (*const begin_commit_)(void*);
+  void (*const end_commit_)(void*, int);
+  void* const context_;
+};
+
+struct ConditionalLoginMutationResult {
+  ConditionalLoginMutationStatus status = ConditionalLoginMutationStatus::kError;
+  PasswordStoreChangeList changes;
+};
+
+using ConditionalLoginMutationReply =
+    base::OnceCallback<void(ConditionalLoginMutationResult)>;
+
+}
