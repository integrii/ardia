+ConditionalLoginMutationResult LoginDatabase::CompareAndSetLogin(
+    ConditionalLoginMutation mutation,
+    scoped_refptr<PasswordStoreAuthorizationLease> lease,
+    base::OnceCallback<bool(const PasswordStoreChangeList&)> before_commit) {
+#if BUILDFLAG(IS_IOS)
+  return {};
+#else
+  if (!db_.is_open() || db_.HasActiveTransactions() || !mutation.IsValid()) {
+    return {};
+  }
+  if (!lease || !lease->IsAuthorized()) {
+    return {ConditionalLoginMutationStatus::kUnauthorized, {}};
+  }
+  auto transaction = CreateTransaction();
+  if (!transaction || !transaction->Begin()) {
+    return {};
+  }
+  std::vector<StoredCredential> credentials;
+  {
+    sql::Statement statement(db_.GetUniqueStatement("SELECT * FROM logins"));
+    if (StatementToStoredCredentials(&statement, nullptr, &credentials, false) !=
+        FormRetrievalResult::kSuccess) {
+      return {};
+    }
+  }
+  StoredCredential* current = nullptr;
+  for (auto& credential : credentials) {
+    if (credential.username_value != mutation.username ||
+        (GURL(credential.signon_realm).DeprecatedGetOriginAsURL() !=
+             mutation.origin &&
+         credential.url.DeprecatedGetOriginAsURL() != mutation.origin)) {
+      continue;
+    }
+    if (current || credential.signon_realm != mutation.origin.spec() ||
+        credential.scheme != PasswordForm::Scheme::kHtml ||
+        credential.url.DeprecatedGetOriginAsURL() != mutation.origin ||
+        credential.blocked_by_user || credential.federation_origin.IsValid()) {
+      return {};
+    }
+    current = &credential;
+  }
+  if (static_cast<bool>(current) != mutation.expected_password.has_value() ||
+      (current && current->password_value != *mutation.expected_password)) {
+    return {ConditionalLoginMutationStatus::kConflict, {}};
+  }
+  PasswordStoreChangeList changes;
+  if (!current) {
+    StoredCredential inserted;
+    inserted.url = mutation.origin;
+    inserted.signon_realm = mutation.origin.spec();
+    inserted.username_value = std::move(mutation.username);
+    inserted.password_value = std::move(*mutation.replacement_password);
+    inserted.date_created = mutation.date_created;
+    inserted.date_password_modified = base::Time::Now();
+    AddCredentialError error = AddCredentialError::kNone;
+    changes = AddLogin(std::move(inserted), &error);
+    if (error != AddCredentialError::kNone || changes.size() != 1 ||
+        changes[0].type() != PasswordStoreChange::ADD) {
+      return {};
+    }
+  } else if (mutation.replacement_password) {
+    if (current->password_value != *mutation.replacement_password) {
+      current->password_value = std::move(*mutation.replacement_password);
+      current->date_password_modified = base::Time::Now();
+      UpdateCredentialError error = UpdateCredentialError::kNone;
+      changes = UpdateLogin(*current, &error);
+      if (error != UpdateCredentialError::kNone || changes.size() != 1) {
+        return {};
+      }
+    }
+  } else if (!RemoveLogin(*current, &changes) || changes.size() != 1) {
+    return {};
+  }
+  if (before_commit && !std::move(before_commit).Run(changes)) {
+    return {};
+  }
+  const auto status = lease->Commit(base::BindOnce(
+      [](std::unique_ptr<sql::Transaction> transaction) {
+        const bool committed = transaction->Commit();
+        transaction.reset();
+        return committed;
+      },
+      std::move(transaction)));
+  if (status != ConditionalLoginMutationStatus::kCommitted) {
+    return {status, {}};
+  }
+  return {status, std::move(changes)};
+#endif
+}
