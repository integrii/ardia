+TEST_F(LoginDatabaseTest, ConditionalInsertPreservesKnownEpochAndUnknownDates) {
+  const base::Time dates[] = {
+      base::Time::FromMillisecondsSinceUnixEpoch(1700000000000),
+      base::Time::UnixEpoch(), base::Time()};
+  for (size_t index = 0; index < std::size(dates); ++index) {
+    auto mutation = MakeConditionalMutation(std::nullopt, u"secret", dates[index]);
+    mutation.username.push_back(static_cast<char16_t>(u'0' + index));
+    auto result = db().CompareAndSetLogin(std::move(mutation), MakeConditionalLease());
+    ASSERT_EQ(result.status, ConditionalLoginMutationStatus::kCommitted);
+    ASSERT_EQ(result.changes.size(), 1u);
+    EXPECT_EQ(result.changes[0].credential().date_created, dates[index]);
+  }
+  std::vector<StoredCredential> rows;
+  ASSERT_EQ(db().GetAllLogins(&rows), FormRetrievalResult::kSuccess);
+  ASSERT_EQ(rows.size(), 3u);
+  for (const auto& row : rows) {
+    const size_t index = row.username_value.back() - u'0';
+    ASSERT_LT(index, std::size(dates));
+    EXPECT_EQ(row.date_created, dates[index]);
+  }
+}
