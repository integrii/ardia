+void PasswordStoreBuiltInBackend::CompareAndSetLoginAsync(
+    ConditionalLoginMutation mutation,
+    scoped_refptr<PasswordStoreAuthorizationLease> lease,
+    ConditionalLoginMutationReply callback) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  if (!helper_ || !is_database_initialized_successfully_ ||
+      !mutation.IsValid()) {
+    std::move(callback).Run(ConditionalLoginMutationResult());
+    return;
+  }
+  if (!lease || !lease->IsAuthorized()) {
+    std::move(callback).Run(
+        {ConditionalLoginMutationStatus::kUnauthorized, {}});
+    return;
+  }
+  std::erase_if(conditional_leases_, [](const auto& existing) {
+    return !existing->IsAuthorized();
+  });
+  if (conditional_leases_.size() >= 128) {
+    std::move(callback).Run(ConditionalLoginMutationResult());
+    return;
+  }
+  conditional_leases_.push_back(lease);
+  auto completion = base::BindOnce(
+      [](base::WeakPtr<PasswordStoreBuiltInBackend> backend,
+         scoped_refptr<PasswordStoreAuthorizationLease> lease,
+         ConditionalLoginMutationReply callback,
+         ConditionalLoginMutationResult result) {
+        if (backend) {
+          std::erase(backend->conditional_leases_, lease);
+        }
+        std::move(callback).Run(std::move(result));
+      },
+      weak_ptr_factory_.GetWeakPtr(), lease, std::move(callback));
+  auto split_completion = base::SplitOnceCallback(std::move(completion));
+  if (!background_task_runner_->PostTaskAndReplyWithResult(
+      FROM_HERE,
+      base::BindOnce(&LoginDatabaseAsyncHelper::CompareAndSetLogin,
+                     base::Unretained(helper_.get()), std::move(mutation),
+                     std::move(lease)),
+      std::move(split_completion.first))) {
+    std::move(split_completion.second).Run(ConditionalLoginMutationResult());
+  }
 }

