+              store->NotifyLoginsChangedOnMainSequence(
+                  LoginsChangedTrigger::ExternalUpdate,
+                  std::optional<PasswordStoreChangeList>(
+                      std::move(result.changes)));
+            }
+            std::move(callback).Run(result.status);
+          },
+          base::WrapRefCounted(this), std::move(callback)));
+}
