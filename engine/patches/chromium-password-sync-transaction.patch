+ConditionalLoginMutation MakeConditionalMutation(
+    std::optional<std::u16string> expected,
+    std::optional<std::u16string> replacement,
+    base::Time created = base::Time()) {
+  ConditionalLoginMutation mutation;
+  mutation.origin = GURL("https://conditional.example/");
+  mutation.username = u"user";
+  if (expected) {
+    mutation.expected_password.emplace(std::move(*expected));
+  }
+  if (replacement) {
+    mutation.replacement_password.emplace(std::move(*replacement));
+  }
+  mutation.date_created = created;
+  return mutation;
+}
+
+scoped_refptr<PasswordStoreAuthorizationLease> MakeConditionalLease() {
+  return base::MakeRefCounted<PasswordStoreAuthorizationLease>(
+      base::TimeTicks::Now() + base::Seconds(10));
+}
