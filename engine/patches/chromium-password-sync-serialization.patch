+TEST(LoginDatabaseSyncSerializationTest,
+     ActualCurrentPopulatedWriterIsAccepted) {
+  const std::u16string text = u"\u03a9\U0001f642";
+  const std::u16string nul_text(u"a\0b", 3);
+  autofill::FormFieldData field;
+  field.set_label(text);
+  field.set_name(nul_text);
+  field.set_value(text);
+  field.set_form_control_type(autofill::FormControlType::kInputPassword);
+  field.set_autocomplete_attribute(std::string("a\0b", 3));
+  field.set_max_length(std::numeric_limits<uint64_t>::max());
+  field.set_is_autofilled_according_to_renderer(true);
+  field.set_is_focusable(false);
+  field.set_should_autocomplete(true);
+  field.set_role(autofill::FormFieldData::RoleAttribute::kPresentation);
+  field.set_text_direction(base::i18n::LEFT_TO_RIGHT);
+  field.set_options({{.value = nul_text, .text = text},
+                     {.value = text, .text = nul_text}});
+  field.set_placeholder(text);
+  field.set_css_classes(nul_text);
+  field.set_properties_mask(autofill::kUserTyped | autofill::kAutofilled |
+                            autofill::kHadFocus | autofill::kErrorOccurred |
+                            autofill::kKnownValue);
+  field.set_id_attribute(text);
+  field.set_name_attribute(nul_text);
+  field.set_nonce(text);
+
+  autofill::FormData form;
+  form.set_name(nul_text);
+  form.set_url(GURL("https://example.test/form?query=1#fragment"));
+  form.set_action(GURL("https://other.test/submit"));
+  form.set_main_frame_origin(url::Origin::Create(GURL("https://example.test")));
+  form.set_fields({field, field});
+  base::Pickle pickle;
+  autofill::SerializeFormData(form, &pickle);
+  auto bytes = Bytes(pickle);
+  const auto saved = bytes;
+  auto decoded = DecodeSyncFormData(bytes);
+  ASSERT_TRUE(decoded);
+  EXPECT_EQ(decoded->name(), nul_text);
+  EXPECT_EQ(decoded->url(), form.url());
+  EXPECT_EQ(decoded->action(), form.action());
+  EXPECT_EQ(decoded->main_frame_origin(), form.main_frame_origin());
+  ASSERT_EQ(decoded->fields().size(), 2u);
+  const auto& actual = decoded->fields()[1];
+  EXPECT_EQ(actual.label(), field.label());
+  EXPECT_EQ(actual.name(), field.name());
+  EXPECT_EQ(actual.value(), field.value());
+  EXPECT_EQ(actual.form_control_type(), field.form_control_type());
+  EXPECT_EQ(actual.autocomplete_attribute(), field.autocomplete_attribute());
+  EXPECT_EQ(actual.max_length(), field.max_length());
+  EXPECT_EQ(actual.is_autofilled_according_to_renderer(), true);
+  EXPECT_EQ(actual.is_focusable(), false);
+  EXPECT_EQ(actual.should_autocomplete(), true);
+  EXPECT_EQ(actual.role(), field.role());
+  EXPECT_EQ(actual.text_direction(), field.text_direction());
+  EXPECT_EQ(actual.options(), field.options());
+  EXPECT_EQ(actual.placeholder(), field.placeholder());
+  EXPECT_EQ(actual.css_classes(), field.css_classes());
+  EXPECT_EQ(actual.properties_mask(), field.properties_mask());
+  EXPECT_EQ(actual.id_attribute(), field.id_attribute());
+  EXPECT_EQ(actual.name_attribute(), field.name_attribute());
+  EXPECT_EQ(actual.nonce(), field.nonce());
+  EXPECT_EQ(bytes, saved);
+  bytes.clear();
+  EXPECT_EQ(actual.name(), nul_text);
+}
