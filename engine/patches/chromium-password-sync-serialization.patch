--- /dev/null
+++ b/components/password_manager/core/browser/password_store/login_database_sync_serialization_unittest.cc
@@ -0,0 +1,707 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "components/password_manager/core/browser/password_store/login_database_sync_serialization.h"
+
+#include <cstddef>
+#include <cstdint>
+#include <cstring>
+#include <limits>
+#include <map>
+#include <string>
+#include <string_view>
+#include <utility>
+#include <vector>
+
+#include "base/containers/span.h"
+#include "base/i18n/rtl.h"
+#include "base/pickle.h"
+#include "components/autofill/core/common/form_field_data.h"
+#include "testing/gtest/include/gtest/gtest.h"
+#include "url/gurl.h"
+#include "url/origin.h"
+
+namespace password_manager::internal {
+namespace {
+
+std::vector<uint8_t> Bytes(const base::Pickle& pickle) {
+  auto bytes = pickle.AsBytes();
+  return {bytes.begin(), bytes.end()};
+}
+
+template <typename T>
+void SetScalar(std::vector<uint8_t>& bytes, size_t offset, T value) {
+  ASSERT_LE(offset, bytes.size());
+  ASSERT_LE(sizeof(value), bytes.size() - offset);
+  std::memcpy(base::span(bytes).subspan(offset, sizeof(value)).data(), &value,
+              sizeof(value));
+}
+
+void RepairEnvelope(std::vector<uint8_t>& bytes) {
+  ASSERT_GE(bytes.size(), sizeof(base::Pickle::Header));
+  SetScalar(bytes, 0,
+            static_cast<uint32_t>(bytes.size() - sizeof(base::Pickle::Header)));
+}
+
+struct FormValues {
+  std::u16string text = u"x";
+  std::string control = "text";
+  std::string autocomplete = "username";
+  std::string url = "https://example.test/form";
+  std::string action = "https://example.test/submit";
+  std::string origin = "https://example.test";
+  int old_option_text_count = 2;
+};
+
+struct EncodedForm {
+  std::vector<uint8_t> bytes;
+  std::map<std::string, size_t> offsets;
+};
+
+class FormWriter {
+ public:
+  EncodedForm Write(int version,
+                    int field_version,
+                    bool with_field,
+                    const FormValues& values) {
+    Int("form_version", version);
+    Text("form_name", values.text);
+    if (version == 1) {
+      Text("method", u"POST");
+    }
+    String("url", values.url);
+    String("action", values.action);
+    if (version < 4) {
+      Bool("user_submitted", true);
+    }
+    Int("field_count", with_field ? 1 : 0);
+    if (with_field) {
+      Field(field_version, values);
+    }
+    if (version >= 3 && version <= 7) {
+      Bool("form_tag", false);
+    }
+    if (version >= 5 && version <= 6) {
+      Bool("formless_checkout", true);
+    }
+    if (version >= 6) {
+      String("origin", values.origin);
+    }
+    return {Bytes(pickle_), std::move(offsets_)};
+  }
+
+ private:
+  void Mark(const std::string& name) {
+    offsets_[name] = pickle_.AsBytes().size();
+  }
+
+  void Int(const std::string& name, int value) {
+    Mark(name);
+    pickle_.WriteInt(value);
+  }
+
+  void Bool(const std::string& name, bool value) {
+    Mark(name);
+    pickle_.WriteBool(value);
+  }
+
+  void Text(const std::string& name, std::u16string_view value) {
+    Mark(name);
+    pickle_.WriteString16(value);
+  }
+
+  void String(const std::string& name, std::string_view value) {
+    Mark(name);
+    pickle_.WriteString(value);
+  }
+
+  void Field(int version, const FormValues& values) {
+    Int("field_version", version);
+    Text("label", values.text);
+    Text("name", values.text);
+    Text("value", values.text);
+    String("control", values.control);
+    String("autocomplete", values.autocomplete);
+    Mark("max_length");
+    pickle_.WriteUInt64(std::numeric_limits<uint64_t>::max());
+    Bool("autofilled", true);
+    if (version <= 3) {
+      Bool("checked", false);
+      Bool("checkable", true);
+    } else if (version <= 10) {
+      Int("discarded_check_status", 0);
+    }
+    Bool("focusable", true);
+    Bool("should_autocomplete", false);
+    if (version >= 2) {
+      Int("role", static_cast<int>(
+                      autofill::FormFieldData::RoleAttribute::kPresentation));
+    }
+    Int("direction", base::i18n::RIGHT_TO_LEFT);
+    Int("option_count", 2);
+    if (version < 9) {
+      Text("option_value_0", u"one");
+      Text("option_value_1", u"two");
+      Int("option_text_count", values.old_option_text_count);
+      for (int i = 0; i < values.old_option_text_count; ++i) {
+        Text("option_text_" + std::to_string(i), u"text");
+      }
+    } else {
+      Text("option_value_0", u"one");
+      Text("option_text_0", u"text");
+      Text("option_value_1", u"two");
+      Text("option_text_1", u"text");
+    }
+    if (version >= 3) {
+      Text("placeholder", values.text);
+    }
+    if (version >= 5) {
+      Text("css", values.text);
+    }
+    if (version >= 6) {
+      Mark("properties");
+      pickle_.WriteUInt32(autofill::kUserTyped | autofill::kHadFocus);
+    }
+    if (version >= 7) {
+      Text("id", values.text);
+    }
+    if (version >= 8) {
+      Text("name_attribute", values.text);
+    }
+    if (version >= 10) {
+      Text("nonce", values.text);
+    }
+  }
+
+  base::Pickle pickle_;
+  std::map<std::string, size_t> offsets_;
+};
+
+EncodedForm EncodeForm(int version = 8,
+                       int field_version = 11,
+                       bool with_field = true,
+                       const FormValues& values = {}) {
+  return FormWriter().Write(version, field_version, with_field, values);
+}
+
+void ExpectInvalidEnvelope(const std::vector<uint8_t>& bytes) {
+  EXPECT_FALSE(DecodeSyncAlternativeUsernames(bytes).has_value());
+  EXPECT_FALSE(DecodeSyncGaiaIdHashes(bytes).has_value());
+  EXPECT_FALSE(DecodeSyncFormData(bytes).has_value());
+}
+
+TEST(LoginDatabaseSyncSerializationTest, EmptyBlobIsAnExplicitValidDefault) {
+  auto pairs = DecodeSyncAlternativeUsernames({});
+  auto hashes = DecodeSyncGaiaIdHashes({});
+  auto form = DecodeSyncFormData({});
+  ASSERT_TRUE(pairs);
+  ASSERT_TRUE(hashes);
+  ASSERT_TRUE(form);
+  EXPECT_TRUE(pairs->empty());
+  EXPECT_TRUE(hashes->empty());
+  EXPECT_TRUE(form->fields().empty());
+  EXPECT_TRUE(form->url().is_empty());
+  EXPECT_TRUE(form->main_frame_origin().opaque());
+
+  const auto header_only = Bytes(base::Pickle());
+  auto empty_pairs = DecodeSyncAlternativeUsernames(header_only);
+  auto empty_hashes = DecodeSyncGaiaIdHashes(header_only);
+  ASSERT_TRUE(empty_pairs);
+  ASSERT_TRUE(empty_hashes);
+  EXPECT_TRUE(empty_pairs->empty());
+  EXPECT_TRUE(empty_hashes->empty());
+  EXPECT_FALSE(DecodeSyncFormData(header_only));
+}
+
+TEST(LoginDatabaseSyncSerializationTest, AlternativePairsAreCompleteOwnedText) {
+  const std::u16string embedded_nul(u"a\0b", 3);
+  base::Pickle pickle;
+  pickle.WriteString16(embedded_nul);
+  pickle.WriteString16(u"field");
+  pickle.WriteString16(u"\u03a9\U0001f642");
+  pickle.WriteString16(u"");
+  auto bytes = Bytes(pickle);
+  const auto saved = bytes;
+  auto decoded = DecodeSyncAlternativeUsernames(bytes);
+  ASSERT_TRUE(decoded);
+  ASSERT_EQ(decoded->size(), 2u);
+  EXPECT_EQ((*decoded)[0].value, embedded_nul);
+  EXPECT_EQ((*decoded)[0].name, u"field");
+  EXPECT_EQ((*decoded)[0].field_renderer_id, autofill::FieldRendererId());
+  EXPECT_EQ((*decoded)[1].value, u"\u03a9\U0001f642");
+  EXPECT_TRUE((*decoded)[1].name.empty());
+  EXPECT_EQ(bytes, saved);
+  bytes.clear();
+  EXPECT_EQ((*decoded)[0].value, embedded_nul);
+}
+
+TEST(LoginDatabaseSyncSerializationTest,
+     AlternativePairsRejectIncompleteRecords) {
+  base::Pickle missing_name;
+  missing_name.WriteString16(u"first");
+  EXPECT_FALSE(DecodeSyncAlternativeUsernames(Bytes(missing_name)));
+  missing_name.WriteString16(u"name");
+  missing_name.WriteString16(u"second");
+  EXPECT_FALSE(DecodeSyncAlternativeUsernames(Bytes(missing_name)));
+
+  base::Pickle truncated_first;
+  truncated_first.WriteInt(100);
+  EXPECT_FALSE(DecodeSyncAlternativeUsernames(Bytes(truncated_first)));
+  base::Pickle truncated_later;
+  truncated_later.WriteString16(u"first");
+  truncated_later.WriteString16(u"name");
+  truncated_later.WriteInt(100);
+  EXPECT_FALSE(DecodeSyncAlternativeUsernames(Bytes(truncated_later)));
+
+  for (char16_t surrogate : {char16_t(0xd800), char16_t(0xdc00)}) {
+    for (bool bad_name : {false, true}) {
+      base::Pickle bad;
+      bad.WriteString16(bad_name ? u"value" : std::u16string(1, surrogate));
+      bad.WriteString16(bad_name ? std::u16string(1, surrogate) : u"name");
+      EXPECT_FALSE(DecodeSyncAlternativeUsernames(Bytes(bad)));
+    }
+  }
+}
+
+TEST(LoginDatabaseSyncSerializationTest,
+     HashesAreBinaryAndExactlySha256Length) {
+  const std::string zeros(32, '\0');
+  std::string binary(32, '\xff');
+  binary[3] = '\0';
+  base::Pickle pickle;
+  pickle.WriteString(zeros);
+  pickle.WriteString(binary);
+  const auto bytes = Bytes(pickle);
+  auto decoded = DecodeSyncGaiaIdHashes(bytes);
+  ASSERT_TRUE(decoded);
+  ASSERT_EQ(decoded->size(), 2u);
+  EXPECT_EQ((*decoded)[0].ToBinary(), zeros);
+  EXPECT_EQ((*decoded)[1].ToBinary(), binary);
+  EXPECT_EQ(Bytes(pickle), bytes);
+  for (size_t length : {0u, 1u, 31u, 33u}) {
+    base::Pickle bad;
+    bad.WriteString(std::string(length, 'x'));
+    EXPECT_FALSE(DecodeSyncGaiaIdHashes(Bytes(bad)));
+  }
+  pickle.WriteInt(32);
+  EXPECT_FALSE(DecodeSyncGaiaIdHashes(Bytes(pickle)));
+  for (int length : {-1, 32, std::numeric_limits<int>::max()}) {
+    base::Pickle truncated_first;
+    truncated_first.WriteInt(length);
+    EXPECT_FALSE(DecodeSyncGaiaIdHashes(Bytes(truncated_first)));
+  }
