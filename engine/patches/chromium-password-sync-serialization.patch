+TEST(LoginDatabaseSyncSerializationTest,
+     NonzeroPaddingIsValidAndNeverRewritten) {
+  base::Pickle pairs;
+  pairs.WriteString16(u"x");
+  pairs.WriteString16(u"y");
+  auto pair_bytes = Bytes(pairs);
+  pair_bytes[10] = 0xa5;
+  pair_bytes[11] = 0xff;
+  pair_bytes[18] = 0x7f;
+  pair_bytes[19] = 0x81;
+  const auto saved_pairs = pair_bytes;
+  ASSERT_TRUE(DecodeSyncAlternativeUsernames(pair_bytes));
+  EXPECT_EQ(pair_bytes, saved_pairs);
+
+  auto form = EncodeForm();
+  const size_t padding =
+      form.offsets.at("label") + sizeof(int) + sizeof(char16_t);
+  form.bytes[padding] = 0xff;
+  form.bytes[padding + 1] = 0xa5;
+  const auto saved_form = form.bytes;
+  ASSERT_TRUE(DecodeSyncFormData(form.bytes));
+  EXPECT_EQ(form.bytes, saved_form);
+}
