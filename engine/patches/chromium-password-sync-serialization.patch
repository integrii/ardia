+TEST(LoginDatabaseSyncSerializationTest,
+     AllKnownFormAndFieldVersionsAreAccepted) {
+  for (int form_version = 1; form_version <= 8; ++form_version) {
+    for (int field_version = 1; field_version <= 11; ++field_version) {
+      SCOPED_TRACE(form_version);
+      SCOPED_TRACE(field_version);
+      auto encoded = EncodeForm(form_version, field_version);
+      const auto saved = encoded.bytes;
+      auto decoded = DecodeSyncFormData(encoded.bytes);
+      ASSERT_TRUE(decoded);
+      EXPECT_EQ(decoded->name(), u"x");
+      EXPECT_EQ(decoded->url(), GURL("https://example.test/form"));
+      EXPECT_EQ(decoded->action(), GURL("https://example.test/submit"));
+      ASSERT_EQ(decoded->fields().size(), 1u);
+      const auto& field = decoded->fields()[0];
+      EXPECT_EQ(field.label(), u"x");
+      EXPECT_EQ(field.name(), u"x");
+      EXPECT_EQ(field.value(), u"x");
+      EXPECT_EQ(field.form_control_type(),
+                autofill::FormControlType::kInputText);
+      EXPECT_EQ(field.text_direction(), base::i18n::RIGHT_TO_LEFT);
+      ASSERT_EQ(field.options().size(), 2u);
+      EXPECT_EQ(field.options()[0].value, u"one");
+      EXPECT_EQ(field.options()[1].value, u"two");
+      EXPECT_EQ(field.options()[0].text, u"text");
+      using Role = autofill::FormFieldData::RoleAttribute;
+      EXPECT_EQ(field.role(), field_version >= 2 ? Role::kPresentation
+                                               : Role::kOther);
+      EXPECT_EQ(field.placeholder(), field_version >= 3 ? u"x" : u"");
+      EXPECT_EQ(field.css_classes(), field_version >= 5 ? u"x" : u"");
+      EXPECT_EQ(field.properties_mask(),
+                field_version >= 6 ? autofill::kUserTyped | autofill::kHadFocus
+                                   : 0u);
+      EXPECT_EQ(field.id_attribute(), field_version >= 7 ? u"x" : u"");
+      EXPECT_EQ(field.name_attribute(), field_version >= 8 ? u"x" : u"");
+      EXPECT_EQ(field.nonce(), field_version >= 10 ? u"x" : u"");
+      EXPECT_EQ(decoded->main_frame_origin().opaque(), form_version < 6);
+      EXPECT_EQ(encoded.bytes, saved);
+    }
+  }
+}
