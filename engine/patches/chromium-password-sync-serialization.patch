+++ b/components/password_manager/core/browser/password_store/login_database_sync_serialization.cc
@@ -0,0 +1,340 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "components/password_manager/core/browser/password_store/login_database_sync_serialization.h"
+
+#include <cstddef>
+#include <cstring>
+#include <string>
+#include <string_view>
+#include <utility>
+
+#include "base/containers/span.h"
+#include "base/i18n/rtl.h"
+#include "base/pickle.h"
+#include "base/strings/utf_string_conversions.h"
+#include "components/autofill/core/common/form_field_data.h"
+#include "components/autofill/core/common/unique_ids.h"
+#include "url/gurl.h"
+#include "url/origin.h"
+
+namespace password_manager::internal {
+namespace {
+
+static_assert(sizeof(int) == sizeof(int32_t));
+static_assert(sizeof(base::Pickle::Header) == sizeof(uint32_t));
+
+bool HasFixedPickleEnvelope(base::span<const uint8_t> serialized) {
+  if (serialized.size() < sizeof(base::Pickle::Header)) {
+    return false;
+  }
+  base::Pickle::Header header;
+  std::memcpy(&header, serialized.data(), sizeof(header));
+  return header.payload_size == serialized.size() - sizeof(header) &&
+         header.payload_size % sizeof(uint32_t) == 0;
+}
+
+bool IsStrictUtf16(std::u16string_view text) {
+  std::string utf8;
+  std::u16string round_trip;
+  return base::UTF16ToUTF8(text.data(), text.size(), &utf8) &&
+         base::UTF8ToUTF16(utf8.data(), utf8.size(), &round_trip) &&
+         round_trip == text;
+}
+
+bool IsStrictUtf8(std::string_view text) {
+  std::u16string utf16;
+  std::string round_trip;
+  return base::UTF8ToUTF16(text.data(), text.size(), &utf16) &&
+         base::UTF16ToUTF8(utf16.data(), utf16.size(), &round_trip) &&
+         round_trip == text;
+}
+
+bool IsCanonicalUrl(std::string_view text) {
+  if (text.find('\0') != std::string_view::npos) {
+    return false;
+  }
+  if (text.empty()) {
+    return true;
+  }
+  GURL url(text);
+  return url.is_valid() && url.spec() == text;
+}
+
+bool IsCanonicalOrigin(std::string_view text) {
+  if (text == "null") {
+    return true;
+  }
+  if (text.empty() || text.find('\0') != std::string_view::npos) {
+    return false;
+  }
+  GURL url(text);
+  if (!url.is_valid()) {
+    return false;
+  }
+  url::Origin origin = url::Origin::Create(url);
+  return !origin.opaque() && origin.Serialize() == text;
+}
+
+class CheckedPickleReader {
+ public:
+  explicit CheckedPickleReader(base::span<const uint8_t> serialized)
+      : iterator_(base::PickleIterator::WithData(serialized)) {}
+
+  bool ReadInt(int* value) {
+    return iterator_.RemainingBytes() >= sizeof(int) &&
+           iterator_.ReadInt(value);
+  }
+
+  bool ReadBool() {
+    int value;
+    return ReadInt(&value) && (value == 0 || value == 1);
+  }
+
+  bool ReadUInt64() {
+    uint64_t value;
+    return iterator_.RemainingBytes() >= sizeof(value) &&
+           iterator_.ReadUInt64(&value);
+  }
+
+  bool ReadPropertiesMask() {
+    uint32_t value;
+    constexpr uint32_t known_flags =
+        autofill::kUserTyped | autofill::kAutofilled | autofill::kHadFocus |
+        autofill::kErrorOccurred | autofill::kKnownValue;
+    return iterator_.RemainingBytes() >= sizeof(value) &&
+           iterator_.ReadUInt32(&value) && (value & ~known_flags) == 0;
+  }
+
+  bool ReadCount(size_t minimum_bytes, int* count) {
+    return ReadInt(count) && *count >= 0 &&
+           static_cast<size_t>(*count) <=
+               iterator_.RemainingBytes() / minimum_bytes;
+  }
+
+  bool ReadBinaryString(std::string* text) {
+    return HasCompleteString(sizeof(char)) && iterator_.ReadString(text);
+  }
+
+  bool ReadUtf8(std::string* text) {
+    return ReadBinaryString(text) && IsStrictUtf8(*text);
+  }
+
+  bool ReadUtf16(std::u16string* text) {
+    return HasCompleteString(sizeof(char16_t)) &&
+           iterator_.ReadString16(text) && IsStrictUtf16(*text);
+  }
+
+  bool ReadUtf16() {
+    std::u16string text;
+    return ReadUtf16(&text);
+  }
+
+  bool ReadUrl() {
+    std::string text;
+    return ReadUtf8(&text) && IsCanonicalUrl(text);
+  }
+
+  bool ReadOrigin() {
+    std::string text;
+    return ReadUtf8(&text) && IsCanonicalOrigin(text);
+  }
+
+  bool ReadControlType() {
+    std::string text;
+    return ReadUtf8(&text) && text.find('\0') == std::string::npos &&
+           autofill::StringToFormControlTypeDiscouraged(text).has_value();
+  }
+
+  bool ReadRole() {
+    int value;
+    using Role = autofill::FormFieldData::RoleAttribute;
+    return ReadInt(&value) &&
+           (value == static_cast<int>(Role::kPresentation) ||
+            value == static_cast<int>(Role::kOther));
+  }
+
+  bool ReadTextDirection() {
+    int value;
+    return ReadInt(&value) &&
+           (value == base::i18n::UNKNOWN_DIRECTION ||
+            value == base::i18n::RIGHT_TO_LEFT ||
+            value == base::i18n::LEFT_TO_RIGHT);
+  }
+
+  bool ReachedEnd() const { return iterator_.ReachedEnd(); }
+
+ private:
+  bool HasCompleteString(size_t unit_size) const {
+    base::PickleIterator probe = iterator_;
+    int length;
+    if (!probe.ReadInt(&length) || length < 0 ||
+        static_cast<size_t>(length) > probe.RemainingBytes() / unit_size) {
+      return false;
+    }
+    const size_t bytes = static_cast<size_t>(length) * unit_size;
+    const size_t padding = (sizeof(uint32_t) - bytes % sizeof(uint32_t)) %
+                           sizeof(uint32_t);
+    return padding <= probe.RemainingBytes() - bytes;
+  }
+
+  base::PickleIterator iterator_;
+};
+
+bool ReadStringVector(CheckedPickleReader& reader, int* count) {
+  if (!reader.ReadCount(sizeof(int), count)) {
+    return false;
+  }
+  for (int i = 0; i < *count; ++i) {
+    if (!reader.ReadUtf16()) {
+      return false;
+    }
+  }
+  return true;
+}
+
+bool ReadOptions(CheckedPickleReader& reader, int field_version) {
+  if (!reader.ReadTextDirection()) {
+    return false;
+  }
+  if (field_version < 9) {
+    int values;
+    int texts;
+    return ReadStringVector(reader, &values) &&
+           ReadStringVector(reader, &texts) && values == texts;
+  }
+  int count;
+  if (!reader.ReadCount(2 * sizeof(int), &count)) {
+    return false;
+  }
+  for (int i = 0; i < count; ++i) {
+    if (!reader.ReadUtf16() || !reader.ReadUtf16()) {
+      return false;
+    }
+  }
+  return true;
+}
+
+bool ReadField(CheckedPickleReader& reader) {
+  int version;
+  std::string autocomplete;
+  if (!reader.ReadInt(&version) || version < 1 || version > 11 ||
+      !reader.ReadUtf16() || !reader.ReadUtf16() || !reader.ReadUtf16() ||
+      !reader.ReadControlType() || !reader.ReadUtf8(&autocomplete) ||
+      !reader.ReadUInt64() || !reader.ReadBool()) {
+    return false;
+  }
+  if (version <= 3) {
+    if (!reader.ReadBool() || !reader.ReadBool()) {
+      return false;
+    }
+  } else if (version <= 10) {
+    int discarded_check_status;
+    if (!reader.ReadInt(&discarded_check_status)) {
+      return false;
+    }
+  }
+  if (!reader.ReadBool() || !reader.ReadBool() ||
+      (version >= 2 && !reader.ReadRole()) ||
+      !ReadOptions(reader, version) ||
+      (version >= 3 && !reader.ReadUtf16()) ||
+      (version >= 5 && !reader.ReadUtf16()) ||
+      (version >= 6 && !reader.ReadPropertiesMask()) ||
+      (version >= 7 && !reader.ReadUtf16()) ||
+      (version >= 8 && !reader.ReadUtf16()) ||
+      (version >= 10 && !reader.ReadUtf16())) {
+    return false;
+  }
+  return true;
+}
+
+bool PreflightForm(CheckedPickleReader& reader) {
+  int version;
+  if (!reader.ReadInt(&version) || version < 1 || version > 8 ||
+      !reader.ReadUtf16() || (version == 1 && !reader.ReadUtf16()) ||
+      !reader.ReadUrl() || !reader.ReadUrl() ||
+      (version < 4 && !reader.ReadBool())) {
+    return false;
+  }
+  int count;
+  if (!reader.ReadCount(sizeof(int), &count)) {
+    return false;
+  }
+  for (int i = 0; i < count; ++i) {
+    if (!ReadField(reader)) {
+      return false;
+    }
+  }
+  return !(version >= 3 && version <= 7 && !reader.ReadBool()) &&
+         !(version >= 5 && version <= 6 && !reader.ReadBool()) &&
+         !(version >= 6 && !reader.ReadOrigin()) && reader.ReachedEnd();
+}
+
+}
+
+std::optional<AlternativeElementVector> DecodeSyncAlternativeUsernames(
+    std::vector<uint8_t> serialized) {
+  AlternativeElementVector result;
+  if (serialized.empty()) {
+    return result;
+  }
+  if (!HasFixedPickleEnvelope(serialized)) {
+    return std::nullopt;
+  }
+  CheckedPickleReader reader(serialized);
+  while (!reader.ReachedEnd()) {
+    std::u16string value;
+    std::u16string name;
+    if (!reader.ReadUtf16(&value) || !reader.ReadUtf16(&name)) {
+      return std::nullopt;
+    }
+    result.emplace_back(AlternativeElement::Value(std::move(value)),
+                        autofill::FieldRendererId(),
+                        AlternativeElement::Name(std::move(name)));
+  }
+  return result;
+}
+
+std::optional<std::vector<signin::GaiaIdHash>> DecodeSyncGaiaIdHashes(
+    std::vector<uint8_t> serialized) {
+  std::vector<signin::GaiaIdHash> result;
+  if (serialized.empty()) {
+    return result;
+  }
+  if (!HasFixedPickleEnvelope(serialized)) {
+    return std::nullopt;
+  }
+  CheckedPickleReader reader(serialized);
+  while (!reader.ReachedEnd()) {
+    std::string hash;
+    if (!reader.ReadBinaryString(&hash) || hash.size() != 32) {
+      return std::nullopt;
+    }
+    result.push_back(signin::GaiaIdHash::FromBinary(std::move(hash)));
+  }
+  return result;
+}
+
+std::optional<autofill::FormData> DecodeSyncFormData(
+    std::vector<uint8_t> serialized) {
+  if (serialized.empty()) {
+    return autofill::FormData();
+  }
+  if (!HasFixedPickleEnvelope(serialized)) {
+    return std::nullopt;
+  }
+  CheckedPickleReader reader(serialized);
+  if (!PreflightForm(reader)) {
+    return std::nullopt;
+  }
+  base::PickleIterator iterator = base::PickleIterator::WithData(serialized);
+  autofill::FormData result;
+  if (!autofill::DeserializeFormData(&iterator, &result) ||
+      !iterator.ReachedEnd()) {
+    return std::nullopt;
+  }
+  return result;
+}
+
+}
diff --git a/components/password_manager/core/browser/password_store/login_database_sync_serialization_unittest.cc b/components/password_manager/core/browser/password_store/login_database_sync_serialization_unittest.cc
