+TEST(LoginDatabaseSyncSerializationTest, FixedEnvelopeRejectsInvalidFraming) {
+  for (size_t length = 1; length < sizeof(base::Pickle::Header); ++length) {
+    ExpectInvalidEnvelope(std::vector<uint8_t>(length, 0));
+  }
+  auto extended_header = Bytes(base::Pickle());
+  extended_header.insert(extended_header.end(), 4, 0);
+  ExpectInvalidEnvelope(extended_header);
+
+  auto valid = EncodeForm().bytes;
+  auto trailing = valid;
+  trailing.push_back(0);
+  ExpectInvalidEnvelope(trailing);
+  for (uint32_t payload : {0u, 1u, std::numeric_limits<uint32_t>::max()}) {
+    auto bad = valid;
+    SetScalar(bad, 0, payload);
+    ExpectInvalidEnvelope(bad);
+  }
+  valid.insert(valid.end(), 4, 0);
+  RepairEnvelope(valid);
+  EXPECT_FALSE(DecodeSyncFormData(valid));
+
+  base::Pickle pairs;
+  pairs.WriteString16(u"v");
+  pairs.WriteString16(u"n");
+  auto pair_bytes = Bytes(pairs);
+  pair_bytes.insert(pair_bytes.end(), 4, 0);
+  RepairEnvelope(pair_bytes);
+  EXPECT_FALSE(DecodeSyncAlternativeUsernames(pair_bytes));
+}
